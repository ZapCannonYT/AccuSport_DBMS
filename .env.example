# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Local PostgreSQL. Replace YOUR_PASSWORD with the password you chose during the
# PostgreSQL install (and 5432 with your port if you changed it).
# The database "accusports" is created automatically by npm run setup-db.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/accusports

# Qdrant, local: run tools/qdrant/qdrant.exe, no key needed
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Web app login sessions (NextAuth). NEXTAUTH_SECRET signs the session cookie:
# set it to any long random string, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
